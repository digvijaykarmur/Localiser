# Copy to .env. Never paste credentials into chat or commit this file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertex-service-account.json
GCP_PROJECT=your-project-id
GCP_LOCATION=global
LOCALISER_WORKSPACE=./workspace

# Model IDs are configurable because Vertex availability changes by region.
# `localiser doctor` verifies these before a paid run.
MODEL_VISION_BULK=gemini-3.7-flash
MODEL_VISION_DEEP=gemini-3.7-flash
MODEL_STORY=gemini-3.7-flash
MODEL_DIALOGUE=gemini-3.7-flash
MODEL_REVIEW=gemini-3.7-flash
