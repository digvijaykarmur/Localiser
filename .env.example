DATABASE_URL=postgres://promo:promo@localhost:5432/promo
REDIS_URL=redis://localhost:6379

# --- Google / Vertex ---------------------------------------------------------
# Either a service account (Vertex AI) ...
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/vertex.json
VERTEX_PROJECT=            # your GCP project
VERTEX_LOCATION=asia-south1
# ... or a Gemini Developer API key (used when VERTEX_PROJECT is empty).
GEMINI_API_KEY=

# --- ElevenLabs --------------------------------------------------------------
ELEVENLABS_API_KEY=

# --- Catalogue + analytics ---------------------------------------------------
ANTRYAMI_BASE_URL=
ANTRYAMI_TOKEN=
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# --- Storage -----------------------------------------------------------------
STORAGE_DRIVER=fs            # fs | gcs
STORAGE_ROOT=./.data
GCS_BUCKET=

# --- Modes -------------------------------------------------------------------
SNAPSHOT_MODE=false          # true = run fully offline from src/data/snapshots
INR_PER_USD=88               # for cost conversion; update quarterly

# --- Ops ---------------------------------------------------------------------
WORKER_MEDIA_CONCURRENCY=    # default: cores - 1
WORKER_PROVIDER_CONCURRENCY=4
LOG_LEVEL=info
