DATABASE_URL=postgres://stage:stage@localhost:5432/stage_promo
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ROOT=./public/storage
NEXT_PUBLIC_APP_URL=http://localhost:3000

# false = use live adapters when that provider's credentials exist.
# true  = force snapshots for every provider (offline).
SNAPSHOT_MODE=false

# Dashboard name map (both sides work; left is canonical):
#   VERTEX_PROJECT          = GCP_PROJECT_ID
#   VERTEX_LOCATION         = VERTEX_GEMINI_LOCATION
#   GOOGLE_APPLICATION_CREDENTIALS = file written from GCP_SA_KEY_JSON
#   ANTRYAMI_BASE_URL       = ANTRYAMI_API_URL
#   CLICKHOUSE_PASSWORD     = CLICKHOUSE_PASS
# Run `pnpm env:check` to ping live providers without printing secrets.
VERTEX_PROJECT=
GCP_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_GEMINI_LOCATION=global
VERTEX_PLAN_MODEL=
VERTEX_JUDGE_MODEL=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
# Optional instead of a file: full service-account JSON on one line
GCP_SA_KEY_JSON=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Antryami (ANTRYAMI_BASE_URL and ANTRYAMI_API_URL are aliases)
ANTRYAMI_BASE_URL=
ANTRYAMI_API_URL=
ANTRYAMI_API_KEY=

# ClickHouse (CLICKHOUSE_PASSWORD and CLICKHOUSE_PASS are aliases)
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_PASS=
CLICKHOUSE_DB=
