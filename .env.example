# Vertex AI service-account key (never commit the real file)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex-sa.json
GCP_PROJECT=your-project
GCP_LOCATION=asia-south1

# Root folder for input/, projects/, output/
WORKSPACE=./workspace

# Optional overrides
LOCALISER_DB=chitrakatha.db
LOCALISER_MAX_CONCURRENCY=6
